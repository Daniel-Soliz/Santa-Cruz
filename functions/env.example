# Firebase Functions: configure no ambiente da sua aplicação/projeto
# Não copie secrets para o repositório público.
PUBLIC_SITE_URL=https://daniel-soliz.github.io/Santa-Cruz/
# Depois de publicar a função de webhook, informe sua URL HTTPS, ex.:
# MP_WEBHOOK_URL=https://southamerica-east1-SEU_PROJETO.cloudfunctions.net/mercadoPagoWebhook
# Não confundir com MP_ACCESS_TOKEN e MP_WEBHOOK_SECRET; estes são SECRET MANAGER:
# firebase functions:secrets:set MP_ACCESS_TOKEN
# firebase functions:secrets:set MP_WEBHOOK_SECRET
