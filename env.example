# Exemplo local. Nunca faça commit do arquivo .env real.
PORT=3000
ADMIN_EMAIL=dono@seudominio.com.br
ADMIN_PASSWORD=troque-por-uma-senha-exclusiva-e-forte
# Obrigatório em produção: caminho do volume persistente montado
# DATA_DIR=/mnt/pedidos

# Pagamento online opcional; não ativar sem configurar no painel
# MERCADO_PAGO_ACCESS_TOKEN=
# APP_URL=https://seu-dominio.example

# Mercado Pago Checkout Pro (não adicione credenciais reais ao GitHub)
# MERCADO_PAGO_ACCESS_TOKEN=
# MERCADO_PAGO_WEBHOOK_SECRET=
# APP_URL=https://seu-backend.example
# Somente para testes locais em banco descartável: nunca habilite em produção
# ALLOW_DEMO_ORDERS=true
