{
  "name": "santa-cruz-pedidos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:smoke": "node scripts/smoke-test.mjs",
    "build:pages": "DEPLOY_TARGET=github-pages vite build",
    "test:pages": "node scripts/check-pages-build.mjs",
    "test:payments": "node --import tsx scripts/payment-security-test.mjs",
    "test:firebase": "npm --prefix functions install --no-audit --no-fund && npm --prefix functions run build && npm --prefix functions run test"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "firebase": "^12.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
