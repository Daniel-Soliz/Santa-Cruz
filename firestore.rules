rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check admin roles
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return request.auth.token.role != null 
        ? request.auth.token.role 
        : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isOwner() {
      return isAuthenticated() && getUserRole() == 'Dono';
    }

    function isManager() {
      return isAuthenticated() && (getUserRole() == 'Dono' || getUserRole() == 'Gerente');
    }

    function isStaff() {
      return isAuthenticated() && (getUserRole() == 'Dono' || getUserRole() == 'Gerente' || getUserRole() == 'Atendente');
    }

    // Store Settings
    match /storeSettings/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isManager();
    }

    // Menu Items
    match /menuItems/{itemId} {
      allow read: if resource.data.status != 'oculto' || isStaff();
      allow write: if isManager();
    }

    // Coupons
    match /coupons/{couponId} {
      allow read: if isStaff();
      allow write: if isManager();
    }

    // Orders: Public clients CANNOT write directly with arbitrary prices or payment statuses!
    // Orders creation and updates are performed exclusively by server-authoritative backend/Cloud Functions.
    match /orders/{orderId} {
      allow read: if isStaff() || (request.query.token != null && request.query.token == resource.data.accessToken);
      allow create, update, delete: if isStaff();
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'aprovada' || isStaff();
      allow create: if request.resource.data.status == 'pendente';
      allow update, delete: if isManager();
    }

    // Admin Users & Roles
    match /users/{userId} {
      allow read, write: if isOwner();
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow read: if isOwner();
      allow write: if false; // Only server/functions write
    }
  }
}
