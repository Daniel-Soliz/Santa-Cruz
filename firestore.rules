rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
   function loggedIn() { return request.auth != null; }
   function admin() { return loggedIn() && request.auth.token.admin == true; }
   match /products/{id} {
     allow read: if true;
     allow create, update, delete: if admin();
   }
   match /categories/{id} {
     allow read: if true;
     allow create, update, delete: if admin();
   }
   match /settings/{id} {
     allow read: if id == 'public' || admin();
     allow create, update, delete: if admin();
   }
   match /orders/{id} {
     // Só a conta anônima que criou o pedido ou o administrador pode consultar.
     allow get, list: if admin() || (loggedIn() && resource.data.ownerUid == request.auth.uid);
     // Pedido é criado exclusivamente em Cloud Functions com cálculo confiável.
     // Admin também muda o status por callable, jamais edita pagamentos via cliente.
     allow create, update, delete: if false;
   }
   match /{document=**} { allow read, write: if false; }
 }
}
